Cell[BoxData[{
 RowBox[{"ClearAll", "[", 
  RowBox[{"b0bjReplace", ",", "relabelNestedList", ",", "SUGRAGramMatrix"}], 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"b0bjReplace", "=", 
   RowBox[{"x_", ":>", 
    RowBox[{"x", "+", "2"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"relabelNestedList", "[", "nestedList_", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"counter", "=", "1"}], ",", "relabel"}], "}"}], ",", 
    RowBox[{
     RowBox[{
      RowBox[{"relabel", "[", "element_", "]"}], ":=", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Head", "[", "element", "]"}], "===", "List"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"relabel", "/@", "element"}], ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"counter", "++"}], ";", "\[IndentingNewLine]", 
         RowBox[{"counter", "-", "1"}]}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"relabel", "[", "nestedList", "]"}]}]}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"SUGRAGramMatrix", "[", "nestedList_", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "tensor", ",", "nodes0", ",", "nodes", ",", "relabellist", ",", "edges", 
      ",", "n", ",", "adjacencyMatrix", ",", "diagMatrix", ",", "b0bjMatrix", 
      ",", "mat", ",", "ExPos"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"tensor", "=", 
      RowBox[{"Count", "[", 
       RowBox[{
        RowBox[{"Flatten", "[", "nestedList", "]"}], ",", 
        RowBox[{"_", "?", "NumericQ"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"nodes0", "=", 
      RowBox[{"Flatten", "[", "nestedList", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"nodes", "=", "nodes0"}], ";", "\[IndentingNewLine]", 
     RowBox[{"relabellist", "=", 
      RowBox[{"relabelNestedList", "[", "nestedList", "]"}]}], ";", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"edges", "=", 
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"rep", ",", "allLists", ",", "edgelist"}], "}"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{"rep", "[", "x_", "]"}], ":=", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"ListQ", "[", "x", "]"}], ",", 
            RowBox[{"Last", "@", 
             RowBox[{"Flatten", "[", "x", "]"}]}], ",", "x"}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"allLists", "=", 
          RowBox[{"Cases", "[", 
           RowBox[{"relabellist", ",", "_List", ",", 
            RowBox[{"{", 
             RowBox[{"0", ",", "Infinity"}], "}"}]}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"edgelist", "=", 
          RowBox[{"Catenate", "@", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{
              RowBox[{"Partition", "[", 
               RowBox[{
                RowBox[{"rep", "/@", "#"}], ",", "2", ",", "1"}], "]"}], 
              "&"}], "/@", "allLists"}], ")"}]}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"DeleteDuplicatesBy", "[", 
          RowBox[{"edgelist", ",", "Sort"}], "]"}]}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"n", "=", 
      RowBox[{
       RowBox[{"Length", "[", "nodes", "]"}], "+", "1"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"adjacencyMatrix", "=", 
      RowBox[{"ConstantArray", "[", 
       RowBox[{"0", ",", 
        RowBox[{"{", 
         RowBox[{"n", ",", "n"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Scan", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"adjacencyMatrix", "[", 
            RowBox[{"[", 
             RowBox[{
              RowBox[{
               RowBox[{"#", "[", 
                RowBox[{"[", "1", "]"}], "]"}], "+", "1"}], ",", 
              RowBox[{
               RowBox[{"#", "[", 
                RowBox[{"[", "2", "]"}], "]"}], "+", "1"}]}], "]"}], "]"}], "=",
            "1"}], ";", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"adjacencyMatrix", "[", 
            RowBox[{"[", 
             RowBox[{
              RowBox[{
               RowBox[{"#", "[", 
                RowBox[{"[", "2", "]"}], "]"}], "+", "1"}], ",", 
              RowBox[{
               RowBox[{"#", "[", 
                RowBox[{"[", "1", "]"}], "]"}], "+", "1"}]}], "]"}], "]"}], "=",
            "1"}]}], ")"}], "&"}], ",", "edges"}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"diagMatrix", "=", 
      RowBox[{"DiagonalMatrix", "[", 
       RowBox[{"-", 
        RowBox[{"Join", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"tensor", "-", "9"}], "}"}], ",", "nodes"}], "]"}]}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"b0bjMatrix", "=", 
      RowBox[{"ConstantArray", "[", 
       RowBox[{"0", ",", 
        RowBox[{"{", 
         RowBox[{"n", ",", "n"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Do", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"b0bjMatrix", "[", 
         RowBox[{"[", 
          RowBox[{"1", ",", "ii"}], "]"}], "]"}], "=", 
        RowBox[{
         RowBox[{"b0bjMatrix", "[", 
          RowBox[{"[", 
           RowBox[{"ii", ",", "1"}], "]"}], "]"}], "=", 
         RowBox[{
          RowBox[{"diagMatrix", "[", 
           RowBox[{"[", 
            RowBox[{"ii", ",", "ii"}], "]"}], "]"}], "/.", " ", 
          "b0bjReplace"}]}]}], ",", 
       RowBox[{"{", 
        RowBox[{"ii", ",", "2", ",", "n"}], "}"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"mat", "=", 
      RowBox[{"adjacencyMatrix", "+", "diagMatrix", "+", "b0bjMatrix"}]}], ";",
      "\[IndentingNewLine]", "\[IndentingNewLine]", "mat"}]}], 
   "\[IndentingNewLine]", "]"}]}]}], "Input",
 CellChangeTimes->{{3.982986980531683*^9, 3.982987038453784*^9}, {
  3.982987166369973*^9, 3.982987170433298*^9}, {3.9829872550782213`*^9, 
