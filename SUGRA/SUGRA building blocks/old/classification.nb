Cell[CellGroupData[{

Cell["Compute Classification (T_LST, External, LST Gauge)", "Section",ExpressionUUID->"40659251-86ec-4c05-9073-974a0c23d125"],

Cell["This may take a few minutes for large catalogs.", "Text",ExpressionUUID->"5a4a752f-ff73-42d9-b7e6-f6b98ab4b1f0"],

Cell["\<\
classData = Monitor[
  Table[With[{e = allExt[[i]]},
    <|\"T\" -> e[\"baseT\"],
      \"extGauge\" -> ExtGauge[e],
      \"lstGauge\" -> LSTGauge[e],
      \"Tsugra\" -> e[\"T\"],
      \"det\" -> e[\"det\"],
      \"uni\" -> (Abs[e[\"det\"]] == 1)|>],
    {i, Length[allExt]}],
  ProgressIndicator[i, {1, Length[allExt]}]
];\
\>", "Input",
 CellLabel->
  "In[272]:=",ExpressionUUID->"07736797-1df5-4ecf-83f3-d7bf3f804bc8"],

Cell[CellGroupData[{

Cell["Classification Table", "Subsection",ExpressionUUID->"ca64d3b0-5f13-4fa8-bd5d-f0e60433bb84"],

Cell["\<\
groups = GroupBy[classData, {#[\"T\"], #[\"extGauge\"], #[\"lstGauge\"]} &];
classTable = SortBy[
  KeyValueMap[
    <|\"T_LST\" -> #1[[1]], \"External\" -> #1[[2]],
      \"LST_Gauge\" -> #1[[3]], \"Count\" -> Length[#2],
      \"T_range\" -> MinMax[#2[[All, \"Tsugra\"]]]|> &,
    groups],
  {#[\"T_LST\"], -#[\"Count\"]} &
];\
\>", "Input",
 CellLabel->
  "In[273]:=",ExpressionUUID->"0de09ab8-c95b-4729-9193-62a86559b79d"],

Cell[CellGroupData[{

Cell["Dataset[classTable[[;; Min[50, Length[classTable]]]]]", "Input",
 CellLabel->
  "In[275]:=",ExpressionUUID->"7b7f2c84-d68d-4f21-b686-acad37fb6e5f"],

