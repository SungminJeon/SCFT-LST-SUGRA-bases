Cell["Search Examples", "Section",ExpressionUUID->"4c7a6b58-6efc-4d94-ae25-090664f362a4"],

Cell["\<\
(* Find all bases with e8 in LST gauge *)
e8Bases = Select[allExt, StringContainsQ[LSTGauge[#], \"e8\"] &];
Print[\"e8 bases: \", Length[e8Bases]]\
\>", "Input",ExpressionUUID->"4feb452e-6551-4692-a26d-7fd3b6da316a"],

Cell[CellGroupData[{

Cell["\<\
(* Find bases with hat1 external *)
hat1Bases = Select[allExt, StringContainsQ[ExtGauge[#], \"hat1\"] &];
Print[\"hat1 bases: \", Length[hat1Bases]]\
\>", "Input",
 CellLabel->
  "In[285]:=",ExpressionUUID->"64983e64-fdaa-4096-8f84-fe62a90ffa92"],

Cell[BoxData[
 InterpretationBox[
  RowBox[{"\<\"hat1 bases: \"\>", "\[InvisibleSpace]", "68"}],
  SequenceForm["hat1 bases: ", 68],
  Editable->False]], "Print",
 CellChangeTimes->{3.98679062172108*^9},
 CellLabel->
  "During evaluation of \
In[285]:=",ExpressionUUID->"e3b0bac6-a6bc-451d-81e0-8fc1d3ad09cd"]
}, Open  ]],

Cell["\<\
(* Show first result *)
If[Length[e8Bases] > 0, ShowEntry[e8Bases[[1]]]]\
\>", "Input",
 CellLabel->
  "In[288]:=",ExpressionUUID->"1b92f27a-f863-4fad-9e36-7b5160b6e9c0"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Export to CSV", "Section",ExpressionUUID->"cff11b43-dc0e-469e-832e-cb209f1e4ace"],

Cell[CellGroupData[{

Cell["\<\
Export[\"classification.csv\",
  Prepend[
    Table[{c[\"T_LST\"], c[\"External\"], c[\"LST_Gauge\"], c[\"Count\"]},
      {c, classTable}],
    {\"T_LST\", \"External\", \"LST_Gauge\", \"Count\"}]];
Print[\"Exported to classification.csv\"]\
\>", "Input",
 CellLabel->
  "In[290]:=",ExpressionUUID->"22a23281-3939-4b49-b9d4-57c9c3fd4a0b"],

Cell[BoxData["\<\"Exported to classification.csv\"\>"], "Print",
 CellChangeTimes->{3.986790639357092*^9},
 CellLabel->
  "During evaluation of \
In[290]:=",ExpressionUUID->"3c53950e-f60f-4c6b-a0b9-d00fcda0bc0c"]
}, Open  ]]
}, Open  ]]
