  {\"9-ext\", Length[ext9]},
  {\"10-ext\", Length[ext10]},
  {\"NHC ext\", Length[nhcExt]},
  {Style[\"Total\", Bold], Style[Length[allExt], Bold]}
}, Frame -> All]\
\>", "Input",
 CellLabel->
  "In[407]:=",ExpressionUUID->"b9a1250d-aab0-46ca-a20b-41738d05705b"],

Cell[BoxData[
 TagBox[GridBox[{
    {
     StyleBox["\<\"Category\"\>",
      StripOnInput->False,
      FontWeight->Bold], 
