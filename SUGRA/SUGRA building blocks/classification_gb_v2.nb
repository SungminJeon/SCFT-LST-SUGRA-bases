Cell[CellGroupData[{

Cell["Compute Classification (T_LST, External, LST Gauge)", "Section",ExpressionUUID->"c5943095-d66a-4569-9173-ed7cb8409aef"],

Cell["This will take a while (~1M entries).", "Text",ExpressionUUID->"1958f729-07bb-4336-abca-e8bd69b882c7"],

Cell["\<\
classData = Monitor[
  Table[With[{e = allExt[[i]]},
    <|\"T\" -> e[\"baseT\"],
      \"extGauge\" -> ExtGauge[e],
      \"lstGauge\" -> LSTGauge[e],
      \"sugraGauge\" -> SUGRAGauge[e],
      \"Tsugra\" -> e[\"T\"],
      \"det\" -> e[\"det\"],
      \"uni\" -> (Abs[e[\"det\"]] == 1),
      \"extCount\" -> Length[e[\"externals\"]]|>],
    {i, Length[allExt]}],
  ProgressIndicator[i, {1, Length[allExt]}]
];\
\>", "Input",ExpressionUUID->"a80ad610-77d9-49d9-9ed8-408d753ef13a"],

Cell[CellGroupData[{

Cell["Classification Table", "Subsection",ExpressionUUID->"e96fd3f3-df92-42c9-91ae-710dda90d19f"],

Cell["\<\
groups = GroupBy[classData, {#[\"T\"], #[\"extGauge\"], #[\"lstGauge\"], \
#[\"sugraGauge\"]} &];
classTable = SortBy[
  KeyValueMap[
    <|\"T_H\" -> #1[[1]], \"External\" -> #1[[2]],
      \"LST_Gauge\" -> #1[[3]], \"SUGRA_Gauge\" -> #1[[4]],
      \"Count\" -> Length[#2],
      \"T_range\" -> MinMax[#2[[All, \"Tsugra\"]]]|> &,
    groups],
  {#[\"T_H\"], -#[\"Count\"]} &
];\
\>", "Input",ExpressionUUID->"91823a14-0893-48f6-92cf-8c60e3052b62"],

Cell["Dataset[classTable[[;; Min[50, Length[classTable]]]]]", "Input",ExpressionUUID->"f810bd3c-1db7-4a3f-abd7-6b7c83d950ee"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Summary by T_LST", "Subsection",ExpressionUUID->"9831b64a-bb33-4b77-ba19-45756b380c6e"],

Cell["\<\
tSummary = SortBy[
  KeyValueMap[{#1, Length[#2]} &, GroupBy[classData, #[\"T\"] &]],
  First];
BarChart[tSummary[[All, 2]], ChartLabels -> tSummary[[All, 1]],
  PlotLabel -> \"Bases by T_LST (gravity_blocks_v2)\"]\
\>", "Input",ExpressionUUID->"3ec374a7-c7f5-43a0-8961-7380f0e4470d"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Summary by External Gauge", "Subsection",ExpressionUUID->"0a9f46e8-4d2c-4891-8fa8-51739f0770ae"],

Cell["\<\
extSummary = ReverseSortBy[
  KeyValueMap[{#1, Length[#2]} &, GroupBy[classData, #[\"extGauge\"] &]],
  Last];
Grid[Prepend[extSummary,
  {Style[\"External\", Bold], Style[\"Count\", Bold]}],
  Frame -> All]\
\>", "Input",ExpressionUUID->"0589a162-ca3f-4aec-805e-f24b14f73315"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Summary by LST Gauge (top 30)", "Subsection",ExpressionUUID->"162bb808-4e5c-4178-ba8a-6a5f7e88cb90"],

Cell["\<\
lstSummary = ReverseSortBy[
  KeyValueMap[{#1, Length[#2]} &, GroupBy[classData, #[\"lstGauge\"] &]],
  Last];
Grid[Prepend[lstSummary[[;; Min[30, Length[lstSummary]]]],
  {Style[\"LST Gauge\", Bold], Style[\"Count\", Bold]}],
  Frame -> All]\
\>", "Input",ExpressionUUID->"411b46b6-1c79-4231-9c44-650bd458f813"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Summary by ext count", "Section",ExpressionUUID->"f2651257-9888-4831-9379-b86635acb003"],

Cell["\<\
extCountSummary = SortBy[
  KeyValueMap[{#1, Length[#2]} &, GroupBy[classData, #[\"extCount\"] &]],
  First];
Grid[Prepend[extCountSummary,
  {Style[\"# Externals\", Bold], Style[\"Count\", Bold]}],
  Frame -> All]\
\>", "Input",ExpressionUUID->"c247f4c6-e6b7-428c-b36d-b5288840b924"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Unimodular vs Non-unimodular", "Section",ExpressionUUID->"71542785-4ae1-475a-8010-7adb18f3b02f"],

Cell["\<\
uniCount = Count[classData, _?(#[\"uni\"] &)];
nonuniCount = Length[classData] - uniCount;
PieChart[{uniCount, nonuniCount},
  ChartLabels -> {\"Uni (\" <> ToString[uniCount] <> \")\",
    \"Non-uni (\" <> ToString[nonuniCount] <> \")\"},
  PlotLabel -> \"Determinant Distribution\"]\
\>", "Input",ExpressionUUID->"5339e82f-b675-4a45-93c0-00ba55589c56"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Search Examples", "Section",ExpressionUUID->"72799220-e424-4feb-bfa2-50697376e573"],

Cell["\<\
(* Find all bases with e8 in LST gauge *)
e8Bases = Select[allExt, StringContainsQ[LSTGauge[#], \"e8\"] &];
Print[\"e8 bases: \", Length[e8Bases]]\
\>", "Input",ExpressionUUID->"a1807ddb-7a84-4ef7-bf59-3247313e3779"],

Cell["\<\
(* Find bases with hat1 external *)
hat1Bases = Select[allExt, StringContainsQ[ExtGauge[#], \"hat1\"] &];
Print[\"hat1 bases: \", Length[hat1Bases]]\
\>", "Input",ExpressionUUID->"fa1e90e8-ede1-4897-9e84-5012d12a5e99"],

Cell["\<\
(* Show first result *)
If[Length[e8Bases] > 0, ShowEntry[e8Bases[[1]]]]\
\>", "Input",ExpressionUUID->"dbd684fb-0b67-450f-9f21-5c3489b5e70a"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Export to CSV", "Section",ExpressionUUID->"484d68d8-7d1a-4964-8867-f13e797aabed"],

Cell["\<\
Export[\"classification_gb.csv\",
  Prepend[
    Table[{c[\"T_H\"], c[\"External\"], c[\"LST_Gauge\"], c[\"SUGRA_Gauge\"], \
c[\"Count\"]},
      {c, classTable}],
    {\"T_H\", \"External\", \"LST_Gauge\", \"SUGRA_Gauge\", \"Count\"}]];
Print[\"Exported to classification_gb.csv\"]\
\>", "Input",ExpressionUUID->"f73e3dda-5c27-4e6e-8433-e74a569266ab"]
}, Open  ]]
}, Open  ]]
},
WindowSize->{1000, 783},
WindowMargins->{{220, Automatic}, {Automatic, 0}},
WindowTitle->"SUGRA Classification (gravity_blocks_v2)",
FrontEndVersion->"12.1 for Mac OS X x86 (64-bit) (June 19, 2020)",
StyleDefinitions->"Default.nb",
ExpressionUUID->"73cf372e-fce4-434b-a025-788ef628ee3f"
]
