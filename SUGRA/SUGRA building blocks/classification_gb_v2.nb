   "\[InvisibleSpace]", "\<\"gravity_blocks_v2/cat_nhc_ext_7ext\"\>"}],
  SequenceForm[
  "Loaded ", 7, " entries from ", "gravity_blocks_v2/cat_nhc_ext_7ext"],
  Editable->False]], "Print",
 CellChangeTimes->{3.987066886773527*^9},
 CellLabel->
  "During evaluation of \
In[404]:=",ExpressionUUID->"4ead9175-26bf-40e4-ace8-06071962ca6b"]
}, Open  ]]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Merge all", "Subsection",ExpressionUUID->"ac963f41-5949-4c7b-b562-0db996c9cece"],

Cell[CellGroupData[{

Cell["\<\
allExt = Join[ext1,ext2,ext3,ext4,ext5,ext6,ext7,ext8,ext9,ext10,nhcExt];
Print[\"Total entries: \", Length[allExt]];\
\>", "Input",
 CellLabel->
  "In[405]:=",ExpressionUUID->"05ca0267-6c8a-4800-8128-20c6307836da"],

Cell[BoxData[
 InterpretationBox[
  RowBox[{"\<\"Total entries: \"\>", "\[InvisibleSpace]", "962455"}],
