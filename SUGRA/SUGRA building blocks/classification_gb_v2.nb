Cell[CellGroupData[{

Cell["Define Classification Functions", "Section",ExpressionUUID->"dc2c9ca5-f609-4a0e-a9d9-e8fdb136c780"],

Cell["\<\
nhcToGauge = <|
  \"-3\" -> \"su3\",
  \"-4\" -> \"so8\",
  \"-5\" -> \"f4\",
  \"-6\" -> \"e6\",
  \"-7\" -> \"e7'\",
  \"-8\" -> \"e7\",
  \"-12\" -> \"e8\",
  \"-2-3\" -> \"su2+g2\",
  \"-2-4\" -> \"su8+so16\",
  \"-2-3-2\" -> \"su2+so7+su2\",
  \"-2-2-3\" -> \"sp1+g2\",
  \"pure-2\" -> \"\",
  \"???\" -> \"???\"
|>;
nhcGaugeName[nhcName_String] := Lookup[nhcToGauge, nhcName, nhcName];

LSTGauge[entry_Association] := Module[
  {IF = entry[\"IF\"], n, extIdxs, nonM1, visited, gauges = {}},
  n = Length[IF];
  extIdxs = ExtIndices[entry] + 1;
  nonM1 = Select[Range[n], IF[[#, #]] != -1 && !MemberQ[extIdxs, #] &];
  visited = Association[Thread[nonM1 -> False]];
  Do[
    If[!visited[s],
      Module[{comp = {}, queue = {s}},
        visited[s] = True;
        While[Length[queue] > 0,
          Module[{cur = First[queue]},
            queue = Rest[queue];
            AppendTo[comp, cur];
            Do[If[!visited[nb] && IF[[cur, nb]] != 0,
              visited[nb] = True; AppendTo[queue, nb]], {nb, nonM1}]]];
        comp = Sort[comp];
        Module[{subIF, nhcResult, gName},
          subIF = IF[[comp, comp]];
          nhcResult = NHCLookup[subIF];
          gName = nhcGaugeName[nhcResult[\"name\"]];
          If[gName =!= \"\" && gName =!= Null,
            AppendTo[gauges, gName]]]]],
    {s, nonM1}];
  Module[{tally, parts},
    If[gauges === {}, Return[\"(none)\"]];
    tally = SortBy[Tally[gauges], First];
    parts = Table[
      Module[{name = t[[1]], cnt = t[[2]], wrap},
        wrap = If[StringContainsQ[name, \"+\"], \"(\" <> name <> \")\", \
name];
        If[cnt == 1, name, ToString[cnt] <> \" \" <> wrap]],
      {t, tally}];
    StringRiffle[parts, \" + \"]]
];

ExtGauge[entry_Association] := Module[
  {exts = entry[\"externals\"], gauges},
  gauges = Table[
    Switch[ext[\"extSI\"],
      -2, \"su2\", -3, \"su3\", -4, \"so8\", -5, \"f4\",
      -6, \"e6\", -7, \"e7'\", -8, \"e7\", -12, \"e8\", -1, \"hat1\",
      _, ToString[ext[\"extSI\"]]],
    {ext, exts}];
  StringRiffle[Sort[gauges], \"+\"]
];

(* SUGRA Gauge: NHC decomposition of FULL IF + gauge enhancement *)
SUGRAGauge[entry_Association] := Module[
  {IF = entry[\"IF\"], n, exts, nonM1, visited, gauges = {}},
  n = Length[IF];
  exts = entry[\"externals\"];

  (* 1. NHC decomposition on all non-(-1) curves *)
  nonM1 = Select[Range[n], IF[[#, #]] != -1 &];
  visited = Association[Thread[nonM1 -> False]];
  Do[
    If[!visited[s],
      Module[{comp = {}, queue = {s}},
        visited[s] = True;
        While[Length[queue] > 0,
          Module[{cur = First[queue]},
            queue = Rest[queue];
            AppendTo[comp, cur];
            Do[If[!visited[nb] && IF[[cur, nb]] != 0,
              visited[nb] = True; AppendTo[queue, nb]], {nb, nonM1}]]];
        comp = Sort[comp];
        Module[{subIF, nhcResult, gName},
          subIF = IF[[comp, comp]];
          nhcResult = NHCLookup[subIF];
          gName = nhcGaugeName[nhcResult[\"name\"]];
          If[gName =!= \"\" && gName =!= Null,
            AppendTo[gauges, gName]]]]],
    {s, nonM1}];

  (* 2. Gauge enhancement for hat1 externals *)
  Do[
    If[ext[\"isHat1\"],
      If[ext[\"targetSI\"] == -1,
        AppendTo[gauges, \"su8\"],  (* hat1 -> (-1): su8 *)
        AppendTo[gauges, \"su16\"]  (* hat1 -> (-2): su16 *)
      ]],
    {ext, exts}];

  (* 3. Gauge enhancement for su2 (-2) on standalone (-1) *)
  Do[
    If[!ext[\"isHat1\"] && ext[\"extSI\"] == -2 && ext[\"targetSI\"] == -1,
      (* Check if this -2 is standalone (only connects to -1 curves) *)
      Module[{ci = ext[\"curveIdx\"] + 1, standalone = True},
        Do[If[j != ci && IF[[ci, j]] != 0 && IF[[j, j]] != -1,
          standalone = False], {j, n}];
        If[standalone, AppendTo[gauges, \"su2\"]]]],
    {ext, exts}];

  (* Format: group duplicates as \"2 su2 + 3 su3 + e6\" *)
  Module[{tally, parts},
    If[gauges === {}, Return[\"(none)\"]];
    tally = SortBy[Tally[gauges], First];
    parts = Table[
      Module[{name = t[[1]], cnt = t[[2]], wrap},
        wrap = If[StringContainsQ[name, \"+\"], \"(\" <> name <> \")\", \
name];
        If[cnt == 1, name, ToString[cnt] <> \" \" <> wrap]],
      {t, tally}];
    StringRiffle[parts, \" + \"]]
];\
\>", "Input",
 CellChangeTimes->{{3.987063715948181*^9, 3.987063716378426*^9}},
 CellLabel->
  "In[379]:=",ExpressionUUID->"2b95a620-74d9-4551-8c92-a920c6185e57"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Load All Catalogs from gravity_blocks_v2/", "Section",ExpressionUUID->"0272c588-3a71-47e6-ac77-f4000d8d52b7"],

Cell["\<\
base = \"gravity_blocks_v2/\";

loadGB[prefix_, ranges_] := Join @@ (LoadCatalog /@ 
  Select[(base <> prefix <> # &) /@ ranges, DirectoryQ]);

tranges = {\"t010\",\"t1120\",\"t2130\",\"t3140\",\"t4150\",
  \"t5160\",\"t6170\",\"t7180\",\"t8190\",\"t91100\",
  \"t101110\",\"t111120\",\"t121130\"};\
\>", "Input",
 CellLabel->
  "In[388]:=",ExpressionUUID->"9383a21f-7633-4f1b-b6b3-584356f65cfd"],

