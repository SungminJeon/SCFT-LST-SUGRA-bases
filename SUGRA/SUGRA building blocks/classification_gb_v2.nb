In[405]:=",ExpressionUUID->"dc52c89f-db84-48e5-899d-22f6ddc8924d"]
}, Open  ]]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Entry Count Summary", "Section",ExpressionUUID->"c88c1ad8-5e1e-4bba-b791-b07090abdb17"],

Cell[CellGroupData[{

Cell["\<\
Grid[{
  {Style[\"Category\", Bold], Style[\"Count\", Bold]},
  {\"1-ext\", Length[ext1]},
  {\"2-ext\", Length[ext2]},
  {\"3-ext\", Length[ext3]},
  {\"4-ext\", Length[ext4]},
