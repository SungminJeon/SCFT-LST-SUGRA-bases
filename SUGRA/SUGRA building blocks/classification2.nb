Cell[CellGroupData[{

Cell["Compute Classification", "Section",ExpressionUUID->"2d9f7ac5-67bd-4a1a-9c98-55d634de71bd"],

Cell["\<\
classData = Monitor[
  Table[With[{e = allDSQ[[i]]},
    <|\"T\" -> e[\"baseT\"],
      \"extGauge\" -> ExtGauge[e],
      \"lstGauge\" -> LSTGauge[e],
      \"Tsugra\" -> e[\"T\"],
      \"det\" -> e[\"det\"],
      \"uni\" -> (Abs[e[\"det\"]] == 1),
      \"extCount\" -> Length[e[\"externals\"]]|>],
    {i, Length[allDSQ]}],
  ProgressIndicator[i, {1, Length[allDSQ]}]
];\
\>", "Input",
 CellLabel->
  "In[332]:=",ExpressionUUID->"f55bd319-5bc0-4d0f-8903-900a29812a14"],

Cell[CellGroupData[{

Cell["Classification Table", "Subsection",ExpressionUUID->"af0ec5bb-6cb0-46aa-93eb-37d037bdeebd"],

Cell["\<\
groups = GroupBy[classData, {#[\"T\"], #[\"extGauge\"], #[\"lstGauge\"]} &];
classTable = SortBy[
  KeyValueMap[
    <|\"T_LST\" -> #1[[1]], \"External\" -> #1[[2]],
      \"LST_Gauge\" -> #1[[3]], \"Count\" -> Length[#2],
      \"T_range\" -> MinMax[#2[[All, \"Tsugra\"]]]|> &,
    groups],
  {#[\"T_LST\"], -#[\"Count\"]} &
];\
\>", "Input",
 CellLabel->
  "In[333]:=",ExpressionUUID->"aac87790-87ba-4430-9a4b-54846ce52635"],

Cell[CellGroupData[{

Cell["Dataset[classTable[[;; Min[50, Length[classTable]]]]]", "Input",
 CellLabel->
  "In[335]:=",ExpressionUUID->"362d0886-f858-4866-a48c-a19135416438"],

